# A funded testnet account that deploys the event contract and creates dedicated demo wallets.
# Its full-access private key, as exported by your wallet or near-cli.
SEED_FUNDER_ACCOUNT_ID=you.testnet
SEED_FUNDER_PRIVATE_KEY=ed25519:...
# Optional testnet RPC override. Mainnet is refused by scripts/testnet.mjs.
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com
